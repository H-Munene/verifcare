PORT=3000

# routes/checkin.ts's geofence check (HEZ-33) and dependant step (HEZ-35) - all optional,
# defaulting to these same values if unset (backend/src/config.ts). Listed here so they're
# discoverable, the same reason PORT is.
GEOFENCE_ACCURACY_THRESHOLD_METERS=20
CHECKIN_SESSION_TOKEN_TTL_SECONDS=600
CHECKIN_CO_PRESENCE_WINDOW_SECONDS=120

# Matches docker-compose.yml at the repo root: `docker compose up -d`, then `npm run db:migrate`.
# Host port is 5433, not Postgres's default 5432, to avoid colliding with a Postgres already
# installed and running locally (see docker-compose.yml's comment for why).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mzazi_care_dev

# A disposable database - integration tests truncate every table between tests.
# Never point this at the same database as DATABASE_URL. Create it once with:
#   psql -h localhost -p 5433 -U postgres -c "CREATE DATABASE mzazi_care_test;"
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/mzazi_care_test

# The real, deployed Cognito User Pool (there is no local Cognito emulator in this project's
# stack, so local dev authenticates against the actual AWS-hosted user pool). See
# docs/project-state.md for these real values. All three app-client ids must be set - the ID
# token verifier accepts tokens from any of them (one per client application: web, caregiver
# mobile, family-member mobile - see infra/lib/auth.ts). A real bug (2026-09-14): leaving out the
# mobile client ids here made every mobile sign-in fail backend calls with a generic 401.
USER_POOL_ID=eu-west-1_901G3wGkr
USER_POOL_CLIENT_ID=62h8bi9cih94nhcd3hom9kheol
CAREGIVER_USER_POOL_CLIENT_ID=4th550b5rk8st5fmgfdio465tr
FAMILY_MEMBER_USER_POOL_CLIENT_ID=7b63vkbmrooqvu4g5to6c1gtvk

# The real, deployed biometric-enrollments S3 bucket (HEZ-31) - same "no local emulator" reasoning
# as the Cognito values above, and same "physical name isn't the architecture.md label" note as
# aws-infra-setup-log.md's CDK bucket construct (CloudFormation-generated, globally unique).
BIOMETRIC_ENROLLMENTS_BUCKET_NAME=mzazicarestack-biometricenrollmentsbuckete1b7d3ba-udjy18fdi2be

# The Rekognition Collection ID (HEZ-85) - a literal, hand-chosen id (not a CloudFormation-
# generated physical name like the bucket above), since Rekognition collection ids are only unique
# within this AWS account/region, not globally like S3 bucket names.
BIOMETRIC_FACES_COLLECTION_ID=mzazi-care-biometric-faces
