PORT=3000

# Optional. These are the defaults.
GEOFENCE_ACCURACY_THRESHOLD_METERS=20
CHECKIN_SESSION_TOKEN_TTL_SECONDS=600
CHECKIN_QR_TOKEN_TTL_SECONDS=60

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mzazi_care_dev

# Integration tests wipe this database. Never point it at DATABASE_URL.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/mzazi_care_test

# Cognito user pool. All three client IDs are required.
USER_POOL_ID=eu-west-1_DyvwyuZL6
USER_POOL_CLIENT_ID=huurdhbpru636ulks4d9k65ql
CAREGIVER_USER_POOL_CLIENT_ID=7p0dhh5gnpev1bc6i6trbhigom
FAMILY_MEMBER_USER_POOL_CLIENT_ID=6b3lpmgevup4tn8vej9m0j4ij2

# VisitAudioBucketName stack output.
VISIT_AUDIO_BUCKET_NAME=replace-with-the-VisitAudioBucketName-stack-output
