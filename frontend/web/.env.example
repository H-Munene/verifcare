# Points at the local Express dev server (backend/), not the deployed API Gateway - see
# docs/project-state.md for why local dev, against the real deployed Cognito User Pool below, is
# this project's established testing track (there is no local Cognito emulator anywhere in this
# stack). Pointing this at the real deployed ApiUrl instead works too, but needs a CORS entry added
# to infra/lib/api.ts's LambdaRestApi first - not done yet.
VITE_API_BASE_URL=http://localhost:3000

# The real, deployed Cognito User Pool - same values as backend/.env.example. See
# docs/project-state.md for these real values.
VITE_USER_POOL_ID=eu-west-1_901G3wGkr
VITE_USER_POOL_CLIENT_ID=62h8bi9cih94nhcd3hom9kheol

# Google Maps JavaScript API key (HEZ-86) - used by components/ExactLocationMap.tsx for the
# bounded exact-location pin step of dependant registration, after county/constituency/ward is
# already chosen via OpenStreetMap boundary data (components/LocationSelector.tsx - no key
# needed for that part). Create one in the Google Cloud Console, enable the "Maps JavaScript API"
# for it, and restrict it (API restrictions -> Maps JavaScript API only; application restrictions
# -> HTTP referrers for this app's actual origin(s), e.g. http://localhost:5173/* for local dev).
VITE_GOOGLE_MAPS_API_KEY=
